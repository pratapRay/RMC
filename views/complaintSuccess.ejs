<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FixIt | Complaint Registered</title>
  <link rel="shortcut icon" href="/images/logo.png" type="image/x-icon" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />
  <style>
    :root {
      --blue: #1a73f8;
      --accent: #00e5c0;
      --bg: #0a0e1a;
      --surface: #111827;
      --surface2: #1c2333;
      --text: #f0f4ff;
      --muted: #7b8db0;
      --border: rgba(255,255,255,0.07);
      --green: #22c55e;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 20px;
      position: relative;
      overflow: hidden;
    }

    /* bg orbs */
    .orb {
      position: fixed; border-radius: 50%; filter: blur(70px); opacity: 0.35;
      animation: floatOrb 7s ease-in-out infinite; pointer-events: none;
    }
    .orb-1 { width: 350px; height: 350px; background: rgba(34,197,94,0.25); top: -60px; left: -80px; }
    .orb-2 { width: 250px; height: 250px; background: rgba(26,115,248,0.2); bottom: -40px; right: -60px; animation-delay: -3.5s; }

    @keyframes floatOrb {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
    }

    /* grid */
    .bg-grid {
      position: fixed; inset: 0;
      background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 50px 50px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent);
      pointer-events: none;
    }

    /* card */
    .success-card {
      position: relative; z-index: 1;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 28px; padding: 56px 48px;
      max-width: 540px; width: 100%; text-align: center;
      animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @keyframes popIn {
      from { opacity: 0; transform: scale(0.88) translateY(20px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* checkmark */
    .check-wrap {
      width: 80px; height: 80px; border-radius: 50%;
      background: rgba(34,197,94,0.1); border: 2px solid rgba(34,197,94,0.3);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 28px;
      animation: checkPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
    }

    @keyframes checkPop {
      from { opacity: 0; transform: scale(0.5); }
      to { opacity: 1; transform: scale(1); }
    }

    .check-icon {
      font-size: 2rem; color: var(--green);
      animation: checkBounce 0.4s ease 0.5s both;
    }

    @keyframes checkBounce {
      0% { transform: scale(1); }
      50% { transform: scale(1.25); }
      100% { transform: scale(1); }
    }

    /* success badge */
    .success-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.25);
      color: var(--green); font-size: 0.72rem; font-weight: 600;
      padding: 4px 12px; border-radius: 50px; letter-spacing: 1px; text-transform: uppercase;
      margin-bottom: 20px;
      animation: fadeSlideUp 0.4s ease 0.3s both;
    }

    .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 6px rgba(34,197,94,0.6); animation: pulse 2s infinite; }

    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    .success-title {
      font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800;
      letter-spacing: -0.5px; margin-bottom: 14px;
      animation: fadeSlideUp 0.4s ease 0.35s both;
    }

    .success-desc {
      font-size: 0.9rem; color: var(--muted); line-height: 1.7;
      margin-bottom: 28px;
      animation: fadeSlideUp 0.4s ease 0.4s both;
    }

    /* quote block */
    .quote-block {
      background: var(--surface2); border: 1px solid var(--border);
      border-left: 3px solid var(--blue); border-radius: 12px;
      padding: 16px 20px; margin-bottom: 32px; text-align: left;
      animation: fadeSlideUp 0.4s ease 0.45s both;
    }

    .quote-block p {
      font-size: 0.82rem; color: var(--muted); line-height: 1.7; font-style: italic;
    }

    /* info row */
    .info-row {
      display: flex; gap: 10px; margin-bottom: 32px;
      animation: fadeSlideUp 0.4s ease 0.5s both;
    }

    .info-pill {
      flex: 1; background: var(--surface2); border: 1px solid var(--border);
      border-radius: 12px; padding: 12px 14px; text-align: center;
    }

    .info-pill-label { font-size: 0.68rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px; }
    .info-pill-val { font-size: 0.85rem; font-weight: 600; color: var(--text); }

    /* btn */
    .btn-ok {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--blue); color: white; border: none;
      padding: 14px 36px; border-radius: 50px; text-decoration: none;
      font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 500;
      cursor: pointer; transition: all 0.2s;
      animation: fadeSlideUp 0.4s ease 0.55s both;
    }
    .btn-ok:hover { background: #0d4fd6; transform: translateY(-2px); box-shadow: 0 10px 28px rgba(26,115,248,0.4); }

    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

<div class="bg-grid"></div>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>

<div class="success-card">
  <div class="check-wrap">
    <i class="bi bi-check-lg check-icon"></i>
  </div>

  <div class="success-badge">
    <div class="badge-dot"></div>
    Successfully Submitted
  </div>

  <h1 class="success-title">Complaint Registered!</h1>

  <p class="success-desc">
    Thank you for stepping up. Your complaint has been received and logged. Our team will begin reviewing and addressing the issue as soon as possible.
  </p>

  <div class="quote-block">
    <p>"The mark of a responsible citizen is not only their ability to recognize a problem, but their willingness to speak up and address it. By registering complaints online, you are taking an active role in making your community a better place."</p>
  </div>

  <div class="info-row">
    <div class="info-pill">
      <div class="info-pill-label">Status</div>
      <div class="info-pill-val" style="color: var(--yellow)">⏳ Pending Review</div>
    </div>
    <div class="info-pill">
      <div class="info-pill-label">Response Time</div>
      <div class="info-pill-val">~36 Hours</div>
    </div>
    <div class="info-pill">
      <div class="info-pill-label">Tracking</div>
      <div class="info-pill-val" style="color: var(--accent)">✓ Active</div>
    </div>
  </div>

  <a class="btn-ok" href="/user/<%=userID %>">
    <i class="bi bi-arrow-left"></i> Back to Dashboard
  </a>
</div>

</body>
</html>