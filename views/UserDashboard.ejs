<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FixIt | My Dashboard</title>
  <link rel="shortcut icon" href="/images/logo.png" type="image/x-icon" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />
  <style>
    :root {
      --blue: #1a73f8;
      --blue-dark: #0d4fd6;
      --accent: #00e5c0;
      --bg: #0a0e1a;
      --surface: #111827;
      --surface2: #1c2333;
      --text: #f0f4ff;
      --muted: #7b8db0;
      --border: rgba(255,255,255,0.07);
      --green: #22c55e;
      --yellow: #f59e0b;
      --red: #ef4444;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--blue); border-radius: 2px; }

    /* NAVBAR */
    nav {
      position: sticky; top: 0; z-index: 100;
      padding: 0 32px; height: 64px;
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(10,14,26,0.9); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }

    .nav-logo { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.3rem; color: var(--text); text-decoration: none; }
    .nav-logo span { color: var(--blue); }

    .nav-right { display: flex; align-items: center; gap: 12px; }

    .nav-add-btn {
      display: flex; align-items: center; gap: 7px;
      background: var(--blue); color: white; border: none;
      padding: 8px 18px; border-radius: 50px;
      font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 500;
      cursor: pointer; text-decoration: none; transition: all 0.2s;
    }
    .nav-add-btn:hover { background: var(--blue-dark); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(26,115,248,0.35); }

    .user-chip {
      display: flex; align-items: center; gap: 8px;
      background: var(--surface); border: 1px solid var(--border);
      padding: 6px 14px 6px 6px; border-radius: 50px;
    }

    .user-avatar {
      width: 30px; height: 30px; border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), var(--accent));
      display: flex; align-items: center; justify-content: center;
      font-size: 0.72rem; font-weight: 700; color: white;
      text-transform: uppercase;
    }

    .user-chip-name { font-size: 0.82rem; font-weight: 500; }

    .btn-logout {
      display: flex; align-items: center; gap: 7px;
      background: transparent; color: var(--muted);
      border: 1px solid var(--border); padding: 7px 14px;
      border-radius: 8px; font-family: 'DM Sans', sans-serif;
      font-size: 0.82rem; cursor: pointer; transition: all 0.2s;
    }
    .btn-logout:hover { border-color: rgba(239,68,68,0.4); color: #fca5a5; background: rgba(239,68,68,0.06); }

    /* PAGE */
    .page-wrapper { max-width: 1100px; margin: 0 auto; padding: 40px 32px 80px; }

    .page-header-row {
      display: flex; align-items: flex-end; justify-content: space-between;
      flex-wrap: wrap; gap: 16px; margin-bottom: 32px;
      animation: fadeSlideUp 0.4s ease forwards;
    }

    .page-title { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800; letter-spacing: -0.5px; }
    .page-subtitle { color: var(--muted); font-size: 0.875rem; margin-top: 4px; }

    .complaint-count-badge {
      background: rgba(26,115,248,0.1); border: 1px solid rgba(26,115,248,0.2);
      color: #7bb3ff; font-size: 0.72rem; font-weight: 600;
      padding: 4px 12px; border-radius: 50px;
    }

    /* EMPTY STATE */
    .empty-state {
      background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
      padding: 80px 40px; text-align: center;
      animation: fadeSlideUp 0.5s ease 0.1s both;
    }
    .empty-icon { font-size: 2.8rem; opacity: 0.3; margin-bottom: 16px; }
    .empty-title { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; }
    .empty-sub { font-size: 0.875rem; color: var(--muted); margin-bottom: 24px; }
    .btn-primary-sm {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--blue); color: white; border: none;
      padding: 10px 22px; border-radius: 50px;
      font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 500;
      cursor: pointer; text-decoration: none; transition: all 0.2s;
    }
    .btn-primary-sm:hover { background: var(--blue-dark); }

    /* GRID */
    .complaints-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }

    /* COMPLAINT CARD */
    .complaint-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
      overflow: hidden; transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
      opacity: 0; animation: fadeSlideUp 0.4s ease forwards;
    }
    .complaint-card:hover { transform: translateY(-5px); border-color: rgba(26,115,248,0.25); box-shadow: 0 16px 40px rgba(0,0,0,0.3); }

    .complaint-card:nth-child(1) { animation-delay: 0.08s; }
    .complaint-card:nth-child(2) { animation-delay: 0.14s; }
    .complaint-card:nth-child(3) { animation-delay: 0.2s; }
    .complaint-card:nth-child(4) { animation-delay: 0.26s; }
    .complaint-card:nth-child(5) { animation-delay: 0.32s; }
    .complaint-card:nth-child(6) { animation-delay: 0.38s; }

    .card-image-wrap { position: relative; height: 160px; overflow: hidden; }
    .card-image-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
    .complaint-card:hover .card-image-wrap img { transform: scale(1.06); }
    .image-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,14,26,0.85), transparent 55%); }
    .image-date { position: absolute; bottom: 10px; left: 14px; font-size: 0.7rem; color: rgba(240,244,255,0.7); display: flex; align-items: center; gap: 5px; }

    .card-body { padding: 18px 20px; }

    .card-title { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; margin-bottom: 10px; }

    .card-address {
      font-size: 0.82rem; color: var(--muted); margin-bottom: 14px;
      display: flex; align-items: flex-start; gap: 6px; line-height: 1.4;
    }
    .card-address i { color: var(--blue); margin-top: 1px; flex-shrink: 0; }
    .card-address a { color: var(--blue); font-size: 0.72rem; margin-left: 3px; text-decoration: none; }

    .status-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
    .status-chip { display: flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 8px; font-size: 0.74rem; font-weight: 500; border: 1px solid transparent; }
    .chip-dot { width: 6px; height: 6px; border-radius: 50%; }
    .chip-pending { background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.2); color: var(--yellow); }
    .chip-pending .chip-dot { background: var(--yellow); box-shadow: 0 0 5px rgba(245,158,11,0.5); }
    .chip-yes { background: rgba(34,197,94,0.08); border-color: rgba(34,197,94,0.2); color: var(--green); }
    .chip-yes .chip-dot { background: var(--green); box-shadow: 0 0 5px rgba(34,197,94,0.5); }
    .chip-no { background: rgba(239,68,68,0.08); border-color: rgba(239,68,68,0.2); color: var(--red); }
    .chip-no .chip-dot { background: var(--red); }
    .chip-started { background: rgba(26,115,248,0.1); border-color: rgba(26,115,248,0.2); color: #7bb3ff; }
    .chip-started .chip-dot { background: var(--blue); box-shadow: 0 0 5px rgba(26,115,248,0.5); }
    .chip-finished { background: rgba(0,229,192,0.08); border-color: rgba(0,229,192,0.2); color: var(--accent); }
    .chip-finished .chip-dot { background: var(--accent); box-shadow: 0 0 5px rgba(0,229,192,0.4); }
    .chip-default { background: var(--surface2); border-color: var(--border); color: var(--muted); }
    .chip-default .chip-dot { background: var(--muted); }

    .officer-row {
      display: flex; align-items: center; gap: 10px;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 10px; padding: 9px 13px; margin-bottom: 14px;
    }
    .officer-avatar {
      width: 28px; height: 28px; border-radius: 50%;
      background: rgba(26,115,248,0.15); border: 1px solid rgba(26,115,248,0.25);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.68rem; color: #7bb3ff; font-weight: 700; flex-shrink: 0;
    }
    .officer-label { font-size: 0.68rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .officer-name { font-size: 0.82rem; font-weight: 500; color: var(--text); }

    /* FEEDBACK */
    .feedback-wrap { margin-bottom: 14px; }
    .feedback-toggle {
      display: flex; align-items: center; gap: 8px;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 10px; padding: 9px 14px; cursor: pointer;
      font-size: 0.82rem; color: var(--muted); transition: all 0.2s;
      width: 100%;
    }
    .feedback-toggle:hover { border-color: rgba(26,115,248,0.3); color: var(--text); }
    .feedback-toggle i { color: var(--blue); }

    .feedback-form {
      display: none; margin-top: 10px; padding: 14px;
      background: var(--surface2); border: 1px solid var(--border); border-radius: 12px;
      animation: fadeSlideUp 0.25s ease;
    }
    .feedback-form.open { display: block; }
    .feedback-form textarea {
      width: 100%; background: var(--bg); border: 1px solid var(--border);
      color: var(--text); border-radius: 8px; padding: 10px 12px;
      font-family: 'DM Sans', sans-serif; font-size: 0.85rem;
      resize: vertical; min-height: 80px; transition: border-color 0.2s;
    }
    .feedback-form textarea:focus { outline: none; border-color: rgba(26,115,248,0.5); }
    .btn-send {
      display: flex; align-items: center; gap: 6px;
      background: var(--blue); color: white; border: none;
      padding: 7px 18px; border-radius: 8px; margin-top: 8px; float: right;
      font-family: 'DM Sans', sans-serif; font-size: 0.8rem; cursor: pointer; transition: all 0.2s;
    }
    .btn-send:hover { background: var(--blue-dark); }

    /* CARD FOOTER */
    .card-footer { padding: 12px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; }
    .btn-delete {
      display: flex; align-items: center; gap: 6px;
      background: transparent; color: var(--muted); border: 1px solid var(--border);
      padding: 7px 14px; border-radius: 8px;
      font-family: 'DM Sans', sans-serif; font-size: 0.78rem; cursor: pointer; transition: all 0.2s;
    }
    .btn-delete:hover { border-color: rgba(239,68,68,0.4); color: var(--red); background: rgba(239,68,68,0.06); }

    /* FAB */
    .fab {
      position: fixed; bottom: 32px; right: 32px;
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--blue); color: white; border: none;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; cursor: pointer; text-decoration: none;
      box-shadow: 0 8px 25px rgba(26,115,248,0.45);
      transition: all 0.2s; z-index: 50;
    }
    .fab:hover { transform: scale(1.1) rotate(90deg); background: var(--blue-dark); }

    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
      nav { padding: 0 16px; }
      .page-wrapper { padding: 24px 16px 80px; }
      .complaints-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- NAVBAR -->
<nav>
  <a class="nav-logo" href="#">Fix<span>It</span> ↗</a>
  <div class="nav-right">
    <a class="nav-add-btn" href="/<%=userID%>/register-complaint">
      <i class="bi bi-plus-lg"></i> New Complaint
    </a>
    <div class="user-chip">
      <div class="user-avatar"><%= userName ? userName.charAt(0) : 'U' %></div>
      <span class="user-chip-name"><%= userName %></span>
    </div>
    <button class="btn-logout logout_btn">
      <i class="bi bi-box-arrow-right"></i> Logout
    </button>
  </div>
</nav>

<!-- PAGE -->
<div class="page-wrapper">
  <div class="page-header-row">
    <div>
      <h1 class="page-title">My Complaints</h1>
      <p class="page-subtitle">Track and manage all your reported issues</p>
    </div>
    <span class="complaint-count-badge"><%= complaints.length %> filed</span>
  </div>

  <% if (complaints.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📭</div>
    <div class="empty-title">No complaints yet</div>
    <p class="empty-sub">You haven't reported any issues. Be the change — file your first complaint now.</p>
    <a class="btn-primary-sm" href="/<%=userID%>/register-complaint">
      <i class="bi bi-plus-lg"></i> File a Complaint
    </a>
  </div>

  <% } else { %>
  <div class="complaints-grid">
    <% complaints.forEach(e => {
      const approvalLower = (e.approvalStatus || 'pending').toLowerCase();
      const workLower = (e.workStatus || '-').toLowerCase();
      let approvalChip = 'chip-pending', approvalLabel = e.approvalStatus || 'Pending';
      if (approvalLower === 'yes') approvalChip = 'chip-yes';
      else if (approvalLower === 'no') approvalChip = 'chip-no';
      let workChip = 'chip-default', workLabel = 'No Update';
      if (workLower === 'started') { workChip = 'chip-started'; workLabel = 'Work Started'; }
      else if (workLower === 'finished') { workChip = 'chip-finished'; workLabel = 'Completed'; }
    %>

    <div class="complaint-card">
      <div class="card-image-wrap">
        <img src="<%= e.imageURL %>" alt="Complaint photo" loading="lazy"
             onerror="this.src='https://placehold.co/400x160/111827/7b8db0?text=No+Image'"/>
        <div class="image-overlay"></div>
        <div class="image-date"><i class="bi bi-calendar3"></i> <%= e.date %></div>
      </div>

      <div class="card-body">
        <div class="card-title"><%= e.title %></div>

        <div class="card-address">
          <i class="bi bi-geo-alt"></i>
          <span><%= e.address %> <a href="<%= e.gMapURL %>" target="_blank"><i class="bi bi-box-arrow-up-right"></i></a></span>
        </div>

        <div class="status-chips">
          <div class="status-chip <%= approvalChip %>">
            <div class="chip-dot"></div> Approval: <%= approvalLabel %>
          </div>
          <div class="status-chip <%= workChip %>">
            <div class="chip-dot"></div> <%= workLabel %>
          </div>
        </div>

        <div class="officer-row">
          <div class="officer-avatar"><%= e.officerAppointed && e.officerAppointed !== '-' ? e.officerAppointed.charAt(0).toUpperCase() : '?' %></div>
          <div>
            <div class="officer-label">Assigned Officer</div>
            <div class="officer-name"><%= e.officerAppointed && e.officerAppointed !== '-' ? e.officerAppointed : 'Not yet assigned' %></div>
          </div>
          <i class="bi bi-person-badge" style="color:var(--muted);font-size:0.9rem;margin-left:auto"></i>
        </div>

        <!-- FEEDBACK -->
        <div class="feedback-wrap">
          <button class="feedback-toggle" onclick="toggleFeedback(this)">
            <i class="bi bi-pen-fill"></i>
            Leave Feedback
            <i class="bi bi-chevron-down" style="margin-left:auto;font-size:0.7rem;transition:transform 0.2s" id="chevron"></i>
          </button>
          <div class="feedback-form">
            <form action="" method="post">
              <textarea name="feedback" placeholder="Share your experience or feedback about this issue..." required></textarea>
              <button type="submit" class="btn-send"><i class="bi bi-send"></i> Send</button>
              <div style="clear:both"></div>
            </form>
          </div>
        </div>
      </div>

      <div class="card-footer">
        <form action="/delete-complaint/<%= e.id %>" method="post">
          <button type="submit" class="btn-delete" name="dashboard" value="userDashboard"
                  onclick="return confirm('Delete this complaint?')">
            <i class="bi bi-trash3"></i> Delete
          </button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- FAB -->
<a class="fab" href="/<%=userID%>/register-complaint" title="New Complaint">+</a>

<script>
  document.querySelector('.logout_btn').addEventListener('click', () => {
    document.cookie = "jwt=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
    location.reload();
  });

  function toggleFeedback(btn) {
    const form = btn.nextElementSibling;
    const chevron = btn.querySelector('#chevron');
    form.classList.toggle('open');
    if (chevron) chevron.style.transform = form.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0)';
  }
</script>
</body>
</html>